# ==========================================
# BeautyFlow 환경변수 템플릿 (.env로 복사 후 실제 키 입력)
# ==========================================

# 1. OpenAI API (필수: 제품 분석 · 기획 · 검증 · Realtime TTS)
OPENAI_API_KEY=

# 2. LangSmith 평가/추적 (선택)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=BeautyFlow-Eval

# 3. Backend FastAPI / SQLite / File Storage
BEAUTYFLOW_STORAGE_DIR=storage
BEAUTYFLOW_DB_PATH=storage/beautyflow.db
BEAUTYFLOW_MAX_UPLOAD_MB=200
BEAUTYFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 4. Frontend Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
